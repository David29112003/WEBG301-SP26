{% extends 'base.html.twig' %}

{% block title %}Admin Dashboard{% endblock %}

{% block body %}

<style>
    body {
        background: #0f172a;
        color: white;
        font-family: Arial;
    }

    .container {
        padding: 30px;
    }

    .stats {
        display: flex;
        gap: 20px;
        margin-bottom: 30px;
    }

    .card {
        flex: 1;
        background: linear-gradient(135deg,#4f46e5,#9333ea);
        padding: 20px;
        border-radius: 12px;
        text-align: center;
    }

    .card h2 {
        font-size: 40px;
    }

    .card p {
        opacity: 0.8;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill,minmax(200px,1fr));
        gap: 20px;
    }

    .dj-card {
        background: rgba(255,255,255,0.05);
        padding: 15px;
        border-radius: 10px;
        text-align: center;
    }

    .dj-card img {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        object-fit: cover;
        margin-bottom: 10px;
    }
</style>

<div class="container">

    <h1>Admin Dashboard</h1>

    <!-- STATS -->
    <div class="stats">
        <div class="card">
            <h2>{{ userCount }}</h2>
            <p>Total Users</p>
        </div>

        <div class="card">
            <h2>{{ eventCount }}</h2>
            <p>Total Events</p>
        </div>
    </div>

    <!-- DJ LIST -->
    <h2>DJ List</h2>

    <div class="grid">
        {% for dj in djs %}
            {% if 'ROLE_DJ' in dj.roles %}
                <div class="dj-card">
                    <img src="{{ dj.avatar ? '/uploads/' ~ dj.avatar : 'https://via.placeholder.com/80' }}">
                    <h4>{{ dj.stageName ?? dj.name }}</h4>
                    <p>{{ dj.genre ?? 'N/A' }}</p>
                    <p>${{ dj.price ?? '0' }}</p>
                </div>
            {% endif %}
        {% endfor %}
    </div>

</div>

{% endblock %}