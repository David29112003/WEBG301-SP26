{% extends 'base.html.twig' %}

{% block title %}Manage Users{% endblock %}

{% block body %}

<style>
    body {
        background: #0f172a;
        color: white;
        font-family: Arial;
    }

    .container {
        padding: 30px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        background: rgba(255,255,255,0.05);
        border-radius: 10px;
        overflow: hidden;
    }

    th, td {
        padding: 12px;
        text-align: center;
    }

    th {
        background: #4f46e5;
    }

    tr:nth-child(even) {
        background: rgba(255,255,255,0.03);
    }

    img {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        object-fit: cover;
    }

    .btn {
        padding: 6px 10px;
        border-radius: 6px;
        color: white;
        text-decoration: none;
        font-size: 12px;
    }

    .blue { background: #4f46e5; }
    .red { background: #dc2626; }
</style>

<div class="container">

    <h1>Manage Users</h1>

    <table>
        <tr>
            <th>Avatar</th>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>DJ Name</th>
            <th>Genre</th>
            <th>Price</th>
            <th>Action</th>
        </tr>

        {% for u in users %}
        <tr>
            <td>
                <img src="{{ u.avatar ? '/uploads/' ~ u.avatar : 'https://via.placeholder.com/50' }}">
            </td>
            <td>{{ u.name }}</td>
            <td>{{ u.email }}</td>
            <td>{{ u.roles|join(', ') }}</td>
            <td>{{ u.stageName ?? '-' }}</td>
            <td>{{ u.genre ?? '-' }}</td>
            <td>{{ u.price ?? '-' }}</td>
            <td>
                <a href="{{ path('admin_user_edit', {id: u.id}) }}" class="btn blue">Edit</a>
                <a href="{{ path('admin_user_delete', {id: u.id}) }}" class="btn red">Delete</a>
            </td>
        </tr>
        {% endfor %}
    </table>

</div>

{% endblock %}