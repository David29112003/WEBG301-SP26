{% extends 'base.html.twig' %}

{% block title %}DJ Dashboard{% endblock %}

{% block body %}

<style>
    body {
        background: #f3f4f6;
        font-family: Arial;
    }

    .container {
        display: flex;
        padding: 30px;
        gap: 20px;
    }

    .left {
        width: 35%;
    }

    .right {
        width: 65%;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .card {
        background: white;
        padding: 20px;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    }

    .btn {
        display: inline-block;
        padding: 12px 20px;
        border-radius: 8px;
        background: #4f46e5;
        color: white;
        text-decoration: none;
        margin-top: 10px;
    }

    .btn:hover {
        background: #4338ca;
    }

    .avatar {
        width: 120px;
        height: 120px;
        border-radius: 50%;
        object-fit: cover;
        border: 3px solid #4f46e5;
    }

    .center {
        text-align: center;
        margin-bottom: 15px;
    }
</style>

<div class="container">

    <!-- LEFT: PROFILE -->
    <div class="left">
        <div class="card">
            <h3>DJ Profile</h3>

            <div class="center">
                {% if app.user and app.user.avatar %}
                    <img src="/uploads/{{ app.user.avatar }}" class="avatar">
                {% else %}
                    <img src="https://via.placeholder.com/120" class="avatar">
                {% endif %}
            </div>

            <p><b>Name:</b> {{ app.user ? app.user.name : 'Demo DJ' }}</p>
            <p><b>Email:</b> {{ app.user ? app.user.email : 'demo@email.com' }}</p>
            <p><b>DJ Name:</b> {{ app.user ? app.user.stageName : 'DJ Demo' }}</p>
            <p><b>Genre:</b> {{ app.user ? app.user.genre : 'EDM' }}</p>
            <p><b>Price:</b> {{ app.user ? app.user.price : '1000' }} $</p>
        </div>
    </div>

    <!-- RIGHT: ACTION -->
    <div class="right">

        <div class="card">
            <h3>Manage Events</h3>
            <p>View your performance schedule</p>

            <a href="{{ path('dj_events') }}" class="btn">
                Go to Events
            </a>
        </div>

        <!-- ❌ ĐÃ XÓA ADD EVENT -->

        <div class="card">
            <h3>Upcoming Events</h3>

            <ul>
                <li>Club ABC - 2026-05-01</li>
                <li>Festival XYZ - 2026-05-10</li>
            </ul>
        </div>

    </div>

</div>

{% endblock %}